# Contact form delivery (https://resend.com). All three are required for the form to send mail.
RESEND_API_KEY=
# Where messages are delivered.
CONTACT_TO_EMAIL=hello@linda.com
# A sender on a domain you have verified in Resend, e.g. "Grafty <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=

# The public address of the site (canonical link, sitemap, share image). Defaults to the Vercel address.
# NEXT_PUBLIC_SITE_URL=https://www.example.com
